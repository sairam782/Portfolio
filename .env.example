# Copy to .env.local for local work. Set the same two values in Vercel for the live site.
# Never commit real values. .env.local is ignored by git.

# Voice guide (optional). Without these the guide button does not appear.
ELEVENLABS_API_KEY=
# Written by `npm run voice:sync` the first time it runs.
ELEVENLABS_AGENT_ID=

# Set when the site moves to a custom domain.
# NEXT_PUBLIC_SITE_URL=https://example.com
